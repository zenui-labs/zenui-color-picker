{
  "name": "@zenui/color-picker-react",
  "version": "1.0.0",
  "description": "A developer-friendly color picker with maximum customization ability also multiple variants and color format support",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build-package",
    "build-package": "tsc --project tsconfig.package.json",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "keywords": [
    "color-picker",
    "react",
    "typescript",
    "component",
    "color",
    "hex",
    "rgb",
    "hsl",
    "developer-tools"
  ],
  "author": "ZenUI Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenui-labs/zenui-color-picker"
  },
  "license": "MIT",
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.1",
    "clsx": "^2.1.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "react-syntax-highlighter": "^15.6.6",
    "tailwind-animate": "^0.2.10",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  }
