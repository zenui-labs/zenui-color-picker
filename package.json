{
  "name": "@zenuilabs/color-picker-react",
  "version": "1.2.0",
  "description": "A small, dependency-free React color picker with wheel, hue box and hue slider variants, alpha, five color formats and CSS-variable theming.",
  "type": "module",
  "main": "./build/index.cjs.js",
  "module": "./build/index.es.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.es.js",
      "require": "./build/index.cjs.js"
    },
    "./style.css": "./build/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:package": "vite build --config vite.build.ts",
    "build": "npm run build:web && npm run build:package",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build:package"
  },
  "keywords": [
    "color-picker",
    "colour-picker",
    "react",
    "typescript",
    "component",
    "color",
    "hex",
    "rgb",
    "hsl",
    "hsv",
    "cmyk",
    "alpha"
  ],
  "author": "ZenUI Labs",
  "homepage": "https://color-picker.zenui.net/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenui-labs/zenui-color-picker.git"
  },
  "bugs": {
    "url": "https://github.com/zenui-labs/zenui-color-picker/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.14.0",
    "react-dom": ">=16.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.3",
    "vite-plugin-lib-inject-css": "^2.2.2"
  }
}
